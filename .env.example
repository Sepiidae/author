# Copy this file to `.env` and fill in your values. `.env` is ignored by git.
# Never commit real secrets.

# --- Database (pick one) ---
# SQLite (default, good for local dev):
DATABASE_URL=sqlite:///./data/book_author.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/book_author
# MariaDB/MySQL:
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/book_author

# --- Auth ---
# CHANGE THIS to a long random string on first run, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google OAuth (optional; leave blank to disable Google login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- AI (our endpoint) ---
AI_API_KEY=
# base_url, model and fast_model default to our endpoint (see config.yaml)
